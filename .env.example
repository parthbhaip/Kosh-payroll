# Kosh environment variables.
# The mysql profile reads these; dev and test need none. Spring also maps APP_DATA_KEY and APP_BASE_URL onto
# app.data-key and app.base-url in every profile, so exported in your shell they replace dev's fixed key and base URL
# (tests always generate their own key). Set them in your shell or IDE run configuration (see HOW-TO-RUN.md).
# Keep real values in .env, which git ignores - never in this file.

# Profile to run: dev (H2 file database, the default) or mysql.
SPRING_PROFILES_ACTIVE=mysql

# MySQL 8 connection. Required.
DB_URL=jdbc:mysql://localhost:3306/kosh
DB_USER=kosh
DB_PASSWORD=

# AES-256 key that encrypts PAN and bank account numbers: base64 of exactly 32 random bytes. Required.
# Generate one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Keep it safe and never change it: without it the encrypted PAN and bank fields cannot be read.
APP_DATA_KEY=

# First admin account, created at startup only while nobody can sign in as admin (also the way back in if every admin
# is disabled). Set both, start Kosh once, sign in, then delete them. The password needs 8 to 64 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Load the fictional demo company, employees and payroll history on startup: true or false. Default false.
SEED_DEMO=false

# Public address of the app, used for links in e-mails. No trailing slash. Required; http://localhost:8080 for a local demo.
APP_BASE_URL=http://localhost:8080

# Folder for uploaded documents, outside the application. Default ./uploads.
UPLOAD_DIR=./uploads

# Outgoing mail over SMTP with authentication. STARTTLS is required (usually port 587); a server without it is refused.
# Password-reset and invite e-mails need these.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address on every e-mail, on a domain your SMTP server may send for. Required.
MAIL_FROM=payroll@example.com
